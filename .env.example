# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx

# Older Supabase projects issue an anon JWT instead. That still works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backups only — NOT used by the app, and deliberately not NEXT_PUBLIC_.
# Project Settings > API Keys > service_role. It bypasses row-level security,
# so it must never be committed or exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
